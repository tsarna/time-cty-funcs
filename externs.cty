//functy:extern

// Time and duration functions, provided in Go by time-cty-funcs (GetTimeFunctions).
// This file declares signatures only — it is never compiled, and nothing here is
// callable.
//
// It exists because cty cannot express what these functions really accept. cty can
// only make a function's *trailing* parameters optional, so an optional argument has
// to be faked with a variadic — which erases its name, its type, and its default.
// And a cty function has one signature, so a function whose argument shapes differ
// per call, or whose return type depends on what it was handed, cannot be described
// at all. Both are declared here: optional and defaulted parameters directly, and
// genuinely overloaded functions as a set of forms, each with its own return type.
//
// `time` and `duration` are the capsule types this package registers. The other 19
// functions it provides are deliberately absent: their cty metadata is complete —
// fixed arity, concrete parameter types, a static return type — so an extern would
// only be a second place for the same facts to drift.

// The current time. Without a zone, in the machine's local zone.
func now(
    tz?: string,  // IANA zone name, e.g. "America/New_York"
) -> time

// Parse a timestamp.
//
// With one argument it reads RFC 3339. With two, the first is a Go reference layout
// ("2006-01-02T15:04:05Z07:00") or an @alias such as @rfc3339. A third argument
// interprets the parsed wall-clock in that zone.
func parsetime(s: string) -> time
func parsetime(format: string, s: string) -> time
func parsetime(format: string, s: string, tz: string) -> time

// Parse a timestamp with a C-style strftime format ("%Y-%m-%d"). Unlike parsetime
// and formattime, @aliases are not resolved here.
func strptime(
    format: string,  // strftime-style layout
    s: string,  // the timestamp to parse
    tz?: string,  // IANA zone; the parsed wall-clock is read as being in it
) -> time

// A time from a Unix epoch count. Always returns a UTC time.
func fromunix(
    n: number,  // the epoch count; fractional seconds are honored
    unit: string = "s",  // one of "s", "ms", "us", "ns"
) -> time

// A time as a Unix epoch count. Seconds are fractional; the other units are whole.
func unix(
    t: time,
    unit: string = "s",  // one of "s", "ms", "us", "ns"
) -> number

// A time's zone name. Without an argument, the machine's local zone.
func timezone(t?: time) -> string

// A duration.
//
// From a string it accepts Go syntax ("1h30m") or ISO 8601 ("PT1H30M"); an ISO
// duration carrying years or months is rejected, since neither has a fixed length.
// From a number it takes the unit as a second argument.
func duration(s: string) -> duration
func duration(
    n: number,  // may be fractional: duration(1.5, "s") is 1.5 seconds
    unit: string,  // one of "h", "m", "s", "ms", "us", "ns"
) -> duration

// Render a duration.
func formatduration(
    d: duration,
    format: string = "go",  // "go" ("1h30m0s") or "iso" ("PT1H30M")
) -> string

// Add a duration to a time.
//
// The (string, string) form is the stdlib-compatible one and is the odd one out: it
// returns a *string*, reads RFC 3339 (not RFC 3339 Nano), and accepts only Go
// duration syntax — so timeadd("2024-01-01T00:00:00Z", "PT5M") fails, while
// timeadd(parsetime("2024-01-01T00:00:00Z"), "PT5M") succeeds.
func timeadd(ts: string, dur: string) -> string
func timeadd(ts: time, dur: duration) -> time
func timeadd(ts: time, dur: string) -> time
func timeadd(ts: string, dur: duration) -> time

// Subtract from a time: another time, giving the duration between them (negative if
// t2 is later), or a duration, giving the earlier time.
func timesub(t1: time, t2: time) -> duration
func timesub(t1: time, d: duration) -> time

// The next DNS zone serial: whichever is greater of s + 1 and today's date in the
// conventional YYYYMMDDNN form, so that the serial always advances.
func nextzoneserial(s: number, t?: time) -> number
func nextzoneserial(s: string, t?: time) -> number

// The date a DNS zone serial in YYYYMMDDNN form encodes, as a UTC midnight time. The
// NN revision suffix is discarded; an out-of-range month or day is snapped.
func parsezoneserial(s: number) -> time
func parsezoneserial(s: string) -> time
